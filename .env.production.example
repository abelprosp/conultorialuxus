# Copie para .env na VPS: cp .env.production.example .env

# Senha forte para o PostgreSQL (obrigatório)
# Caracteres especiais (@, #, :, /, ?) são suportados — a URL é montada com encoding no startup.
POSTGRES_USER=assessoria
POSTGRES_PASSWORD=troque-por-uma-senha-forte-aqui

# Porta exposta no host (somente acesso direto, sem Caddy)
# APP_PORT=38472  → http://IP-DA-VPS:38472
#
# Com Caddy (HTTPS em consultoria.redobrai.online):
# - use deploy/docker-compose.caddy.yml (recomendado) — a app fica só na rede Docker
# - ou, com Caddy instalado no host: APP_PORT=38472 e reverse_proxy localhost:38472
APP_PORT=38472

# ── Mapa de portas do projeto ──────────────────────────────────────────────
# | Serviço              | Ambiente | Porta host | Porta interna | Notas              |
# |----------------------|----------|------------|---------------|--------------------|
# | API (backend dev)    | dev      | 47291      | —             | npm run dev        |
# | Frontend (Vite dev)  | dev      | 51837      | —             | npm run dev        |
# | PostgreSQL           | dev      | 55432      | 5432          | docker-compose.yml |
# | App (produção)       | prod     | 38472      | 3001          | APP_PORT no .env   |
# | Caddy (HTTPS)        | prod     | 80, 443    | 80, 443       | overlay Caddy      |
# | Nginx (reverse proxy)| prod     | 80, 443    | —             | proxy → 38472      |
# ────────────────────────────────────────────────────────────────────────────
