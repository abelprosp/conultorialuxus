# Copie para .env na VPS: cp .env.production.example .env

# Senha forte para o PostgreSQL (obrigatório)
POSTGRES_USER=assessoria
POSTGRES_PASSWORD=troque-por-uma-senha-forte-aqui

# Porta exposta no host (somente acesso direto, sem Caddy)
# APP_PORT=80  → http://IP-DA-VPS
#
# Com Caddy (HTTPS em consultoria.redobrai.online):
# - use deploy/docker-compose.caddy.yml (recomendado) — a app fica só na rede Docker
# - ou, com Caddy instalado no host: APP_PORT=8080 e reverse_proxy localhost:8080
APP_PORT=80
